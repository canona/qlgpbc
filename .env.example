# Cổng HTTP phía host (bên ngoài container). Mặc định 18080 — cổng ít dùng để tránh
# xung đột với các dịch vụ sẵn có trên máy chủ. Cổng trong container luôn là 3000.
HOST_PORT=18080

# Địa chỉ công khai của ứng dụng (dùng để hiển thị ví dụ API trong trang Hàng đợi)
APP_BASE_URL=https://qlgpbc.vtcdigital.top

# AI Gateway (tương thích OpenAI). Có thể để trống và cấu hình trong trang Cài đặt.
# Mặc định: gateway nằm sau cùng tên miền, tại đường dẫn /ai
AI_GATEWAY_URL=https://qlgpbc.vtcdigital.top/ai
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# Thư mục dữ liệu (SQLite thay bằng store.json + thư mục uploads). Trong Docker là /app/data (volume).
DATA_DIR=/app/data

# Giới hạn số trang đưa qua OCR/LLM cho mỗi job (giảm chi phí token)
MAX_OCR_PAGES=10

# Chu kỳ worker quét hàng đợi (giây)
WORKER_INTERVAL_SECONDS=60
